# web.search fallback provider (M7-13c-2a-6) — SERVER-SIDE ONLY, never NEXT_PUBLIC_*.
# Gemini (the tenant's own key) is tried first; Tavily is used when Gemini cannot search. Leave both EMPTY to disable Tavily.
# These must also be set in the Netlify environment at deploy time (Site settings -> Environment variables).
# The key and its credits are the owner's: only tenants listed in TAVILY_ALLOWED_TENANT_IDS may use it (the query text is sent to Tavily).
TAVILY_API_KEY=
# Comma-separated tenant ids that may use the key above, e.g. id1,id2
TAVILY_ALLOWED_TENANT_IDS=
